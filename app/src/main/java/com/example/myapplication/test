@Composable
fun ResearchScreen(ID: String, value: Double, modifier: Modifier = Modifier) {
    val context =
        LocalContext.current // LocalContext.current "grabs" the current environment information

    // Column, Row, Surface and Box composables often act as parent UI containers to help arrange the layout.
    Column( // Column contains multiple children UI elements placed vertically
        // 1. Position inside the Column
        verticalArrangement = Arrangement.Center,       // Centers children vertically

        // 2. Define the layout of the Column. This setting would apply to all its children components
        modifier = modifier
            .height(300.dp)    // Give it a specific height (e.g., 300dp)
            .padding(50.dp)    // Add some breathing room around the edges
            .background(Color.LightGray) // Optional: add color to "see"
    ) {
        Text("Research Measurement App", fontSize = 25.sp)
        Text(
            text = ID,
            lineHeight = 50.sp,
            textAlign = TextAlign.Center,
            modifier = Modifier.align(Alignment.CenterHorizontally) // <--- Individual
        )
        Text("Current value: $value")
        Button(
            onClick = { // When the user clicks the button, run the code inside onClick.
                println("Button clicked")
                // This shows a small popup message at the bottom of the phone screen
                Toast.makeText(context, "Measurement Started!", Toast.LENGTH_SHORT).show()
            }

        ) {
            Text("Start Measurement") // Display the text “Start Measurement” inside the button.
        }
    }

}


