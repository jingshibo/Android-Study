/**
 * MainActivity is the entry point of your Android application.
 * It inherits from ComponentActivity, which provides the base logic for a modern Android screen.
 */
class MainActivity : ComponentActivity() { // MainActivity starts the screen.

    /**
     * onCreate is the first method called when the Activity is created.
     * This is where you initialize your UI and setup the app's state.
     */
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        // enableEdgeToEdge makes the app content draw behind system bars (status bar and navigation bar).
        enableEdgeToEdge()

        // setContent is where you start the compose UI.
        setContent { // UI goes here
            // MyApplicationTheme applies your app's custom colors, typography, and shapes.
            MyApplicationTheme {
                // Scaffold is a parent container, but it is the "Big Boss" of layout containers!
                // It is designed to manage the entire screen structure according to Material Design rules.
                Scaffold(modifier = Modifier.fillMaxSize(),) { innerPadding ->
                    // We call our Greeting composable function and pass it a name and the padding from Scaffold.
                    Column {
                        //1. Modifier: Start with the blank "identity" object.
                        //2. .padding(10.dp): Create a new object that adds padding instructions.
                        //3. .fillMaxWidth(): Create another new object that adds width instructions.
                        Greeting(
                            name = "Android",
                            modifier = Modifier.padding(innerPadding)
                        )
                        // It is a good practice to pass the modifier attribute(s) along with the modifier
                        // from the parent composable. Update the modifier parameter as follows:
                        ResearchScreen(
                            "002",
                            value = 2.35,
                            modifier = Modifier.padding(innerPadding)
                        )
                        GreetingImage(
                            message = stringResource(R.string.happy_birthday_sam),
                            from = "From Emma"
                        )
                    }

                }
            }
        }
    }
}

/**
 * A composable function is a Kotlin function that describes UI.
 * This one displays a "Hello" text message.
 */
@Composable // @Composable means this function can be used by Compose to create UI.
// All functions marked with the @Composable annotation can be called from the setContent() function or from other Composable functions.
// Note: @Composable function names are capitalized and they can't return anything.
fun Greeting(name: String, modifier: Modifier = Modifier) { // Modifier is a default object with all parameters to be blank
    // Surface provides a background layer (like a sheet of paper) for its children.
    Surface(color = Color.Cyan, modifier = modifier) { // Trailing Lambda: curly braces are used for the last 'content' parameter.
        // Note: The following UI components are technically an input parameter of the Surface function,
        // moved into curly braces using Trailing Lambda Syntax for better readability.
        Row(
            modifier = Modifier.padding(20.dp) // Use a NEW modifier for internal spacing
        ) { // Row contains multiple children UI elements placed horizontally
            Text(
                text = name,
                fontSize = 100.sp,
                lineHeight = 116.sp,
            )
            Text( // Text is a common Compose component used for displaying text on the screen.
                text = "Hello $name!",
                modifier = modifier.padding(24.dp) // The modifier put 16 dp of padding around the column.
            )
        }
    }
}

